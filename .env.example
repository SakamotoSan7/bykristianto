# Optional: Base URL for production MP4 hosting (e.g. Cloudflare R2, Bunny Stream, Vercel Blob)
# Leave empty during local `npm run dev` to stream directly from `assets/videos/`.
VITE_VIDEO_BASE_URL=

# Web3Forms configuration for Contact form (fallback to mailto: if unset)
VITE_WEB3FORMS_ACCESS_KEY=
